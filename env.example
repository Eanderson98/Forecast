DATABASE_URL=postgres://forecast:forecast@localhost:5432/forecast
PORT=3001

# Where the built frontend (app/dist) lives, relative to nothing in particular —
# only needed if you're not running from the repo layout this was written for.
# STATIC_DIR=/absolute/path/to/app/dist

# Where task attachments are saved on this server's own disk. Defaults to server/uploads.
# Whatever you set this to, make sure it's on a persistent volume — a plain container
# filesystem gets wiped on rebuild.
# UPLOADS_DIR=/absolute/path/to/uploads
